{
  "name": "zaliczgmine-overlay",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && bun scripts/build.ts",
    "test": "bun test",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --deny-warnings --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test"
  },
  "dependencies": {
    "effect": "^4.0.4"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.4",
    "@effect/tsgo": "^0.51.1",
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "^1.4.3",
    "@types/chrome": "^0.3.5",
    "oxfmt": "^0.73.0",
    "oxlint": "1.88.0",
    "typescript": "^7.0.2"
  }
}
