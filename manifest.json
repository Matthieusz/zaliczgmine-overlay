{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.0.1",
  "description": "__MSG_extensionDescription__",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.komoot.com/*",
    "*://*.komoot.de/*",
    "*://*.komoot.es/*",
    "*://*.komoot.fr/*",
    "*://*.komoot.it/*",
    "*://*.komoot.nl/*",
    "*://veloplanner.com/*",
    "*://zaliczgmine.pl/*",
    "*://tickmyride.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png"
    },
    "default_title": "__MSG_extensionTitle__"
  },
  "icons": {
    "16": "assets/icons/icon16.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.komoot.com/*",
        "*://*.komoot.de/*",
        "*://*.komoot.es/*",
        "*://*.komoot.fr/*",
        "*://*.komoot.it/*",
        "*://*.komoot.nl/*",
        "*://veloplanner.com/*"
      ],
      "js": [
        "i18n.js",
        "logger.js",
        "message-protocol.js",
        "modules/sites.js",
        "content-script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://*.komoot.com/*",
        "*://*.komoot.de/*",
        "*://*.komoot.es/*",
        "*://*.komoot.fr/*",
        "*://*.komoot.it/*",
        "*://*.komoot.nl/*",
        "*://veloplanner.com/*"
      ],
      "resources": [
        "i18n.js",
        "logger.js",
        "message-protocol.js",
        "config.js",
        "modules/sites.js",
        "modules/extension-bridge.js",
        "modules/zaliczgmine-api.js",
        "modules/map-finder.js",
        "modules/communes-geometry.js",
        "modules/communes-data.js",
        "modules/map-layers.js",
        "modules/route-geometry.js",
        "modules/planned-route.js",
        "lib/togeojson.js",
        "modules/gpx.js",
        "map-app.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "default_locale": "en"
}
